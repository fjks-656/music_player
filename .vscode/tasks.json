{
    "tasks": [
        {
            "type": "shell",
            "label": "Build",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "shell",
            "label": "Run",
            "command": "./build/main.exe",
            "dependsOn" : "Build",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
        }
    ],
    "version": "2.0.0"
}